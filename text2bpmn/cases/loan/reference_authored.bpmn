<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="text2bpmn" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Loan Application Eligibility Assessment" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Loan Officer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptance_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Financial Officer">
        <bpmn:flowNodeRef>credit_history</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="System">
        <bpmn:flowNodeRef>loan_risk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Property Appraiser">
        <bpmn:flowNodeRef>appraisal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Application received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="credit_history" name="Check credit history">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="loan_risk" name="Assess loan risk">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="appraisal" name="Appraise property">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="eligibility" name="Assess eligibility">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="reject" name="Reject application">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="acceptance_pack" name="Prepare acceptance pack">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="notify" name="Notify application status">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="and_split" name="" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="and_join" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="xor_split" name="Applicant eligible?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="xor_join" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end" name="Applicant notified">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="and_split" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="and_split" targetRef="credit_history" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="credit_history" targetRef="loan_risk" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="loan_risk" targetRef="and_join" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="and_split" targetRef="appraisal" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="appraisal" targetRef="and_join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="and_join" targetRef="eligibility" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="eligibility" targetRef="xor_split" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="xor_split" targetRef="reject" name="not eligible" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="xor_split" targetRef="acceptance_pack" name="eligible" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="reject" targetRef="xor_join" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="acceptance_pack" targetRef="xor_join" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="xor_join" targetRef="notify" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="notify" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1750" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1720" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="30" y="240" width="1720" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true">
        <dc:Bounds x="30" y="360" width="1720" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true">
        <dc:Bounds x="30" y="480" width="1720" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="137" y="42" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="credit_history_di" bpmnElement="credit_history">
        <dc:Bounds x="405" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="loan_risk_di" bpmnElement="loan_risk">
        <dc:Bounds x="555" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="appraisal_di" bpmnElement="appraisal">
        <dc:Bounds x="405" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eligibility_di" bpmnElement="eligibility">
        <dc:Bounds x="855" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reject_di" bpmnElement="reject">
        <dc:Bounds x="1155" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="acceptance_pack_di" bpmnElement="acceptance_pack">
        <dc:Bounds x="1155" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify">
        <dc:Bounds x="1455" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="and_split_di" bpmnElement="and_split">
        <dc:Bounds x="280" y="35" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="and_join_di" bpmnElement="and_join">
        <dc:Bounds x="730" y="35" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="xor_split_di" bpmnElement="xor_split" isMarkerVisible="true">
        <dc:Bounds x="1030" y="35" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="xor_join_di" bpmnElement="xor_join" isMarkerVisible="true">
        <dc:Bounds x="1330" y="35" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1637" y="42" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="173" y="60" />
        <di:waypoint x="280" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="330" y="60" />
        <di:waypoint x="367.5" y="60" />
        <di:waypoint x="367.5" y="300" />
        <di:waypoint x="405" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="505" y="300" />
        <di:waypoint x="530" y="300" />
        <di:waypoint x="530" y="420" />
        <di:waypoint x="555" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="655" y="420" />
        <di:waypoint x="692.5" y="420" />
        <di:waypoint x="692.5" y="60" />
        <di:waypoint x="730" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="330" y="60" />
        <di:waypoint x="367.5" y="60" />
        <di:waypoint x="367.5" y="540" />
        <di:waypoint x="405" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="505" y="540" />
        <di:waypoint x="617.5" y="540" />
        <di:waypoint x="617.5" y="60" />
        <di:waypoint x="730" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="780" y="60" />
        <di:waypoint x="855" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="955" y="60" />
        <di:waypoint x="1030" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1080" y="60" />
        <di:waypoint x="1155" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1080" y="60" />
        <di:waypoint x="1117.5" y="60" />
        <di:waypoint x="1117.5" y="180" />
        <di:waypoint x="1155" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1255" y="60" />
        <di:waypoint x="1330" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1255" y="180" />
        <di:waypoint x="1292.5" y="180" />
        <di:waypoint x="1292.5" y="60" />
        <di:waypoint x="1330" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1380" y="60" />
        <di:waypoint x="1455" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1555" y="60" />
        <di:waypoint x="1637" y="60" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
