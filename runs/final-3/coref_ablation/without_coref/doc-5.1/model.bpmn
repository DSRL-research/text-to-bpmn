  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="doc-5.1" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Main Process">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1ee108cd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Risk assessment Web service">
        <bpmn:flowNodeRef>Activity_d0959a75</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR_Gateway_5d01ce58</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_6c1e0780</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_d583ff26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_b717baaa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Customer">
        <bpmn:flowNodeRef>Activity_a6189357</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_1ee108cd" name="Receiving a customer request for a loan amount">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_d0959a75" name="Assess the request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR_Gateway_5d01ce58" name="If the loan is small and the customer is low risk" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_6c1e0780" name="Approved the loan">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_d583ff26" name="Denied the loan">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_b717baaa" name="Sent the request">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_a6189357" name="Receives feedback">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_join_1" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_1ee108cd" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_1ee108cd" targetRef="Activity_d0959a75" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_d0959a75" targetRef="XOR_Gateway_5d01ce58" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="XOR_Gateway_5d01ce58" targetRef="Activity_6c1e0780" name="Yes" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="XOR_Gateway_5d01ce58" targetRef="Activity_d583ff26" name="If the customer is high risk" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="XOR_Gateway_5d01ce58" targetRef="Activity_b717baaa" name="If the customer needs further review or the loan amount is for $10,000 or more" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_6c1e0780" targetRef="Gateway_join_1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_d583ff26" targetRef="Gateway_join_1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_b717baaa" targetRef="Gateway_join_1" />
