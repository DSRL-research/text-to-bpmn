      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_49ebd2c8" name="Receive an approval in progress email">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_a32d4955" name="Receives an email cancellation notice">
