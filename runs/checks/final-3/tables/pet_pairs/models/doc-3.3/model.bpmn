      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR_Gateway_39a26609" name="If the claim is marked as Not OK" gatewayDirection="Diverging">
