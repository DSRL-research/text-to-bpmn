<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="text2bpmn" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="doc-5.1" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Main Process">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_d9ef69e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Risk assessment Web service">
        <bpmn:flowNodeRef>Activity_8cb5e878</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0b7533bd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_606f866f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_40d08ace</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Customer">
        <bpmn:flowNodeRef>Activity_3a4a5da4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_d9ef69e4" name="Receiving a customer request for a loan amount">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_8cb5e878" name="Assess the request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0b7533bd" name="Approved the loan">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_606f866f" name="Denied the loan">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_40d08ace" name="Sent the request">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_3a4a5da4" name="Receives feedback">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_d9ef69e4" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_d9ef69e4" targetRef="Activity_8cb5e878" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_40d08ace" targetRef="Activity_3a4a5da4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_3a4a5da4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_8cb5e878" targetRef="Activity_0b7533bd" name="If the loan is small and the customer is low risk" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_0b7533bd" targetRef="Activity_606f866f" name="If the customer is high risk" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_606f866f" targetRef="Activity_40d08ace" name="If the customer needs further review or the loan amount is for $10,000 or more" />
  </bpmn:process>
