      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_9707308b" name="Check">
      <bpmn:documentation>That the issue complies with the so-called blue-sky laws of each state that regulate sales of securities within the state</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_8fd39f1d" name="Awaiting approval">
