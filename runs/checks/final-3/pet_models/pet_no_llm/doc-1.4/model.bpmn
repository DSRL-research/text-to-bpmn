    <bpmn:task id="Activity_0589e4ce" name="Makes the decision to go public">
      <bpmn:documentation>The underwriters</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_6286b059" name="Prepare a registration statement for the approval of the Securities and Exchange Commission ( SEC )">
