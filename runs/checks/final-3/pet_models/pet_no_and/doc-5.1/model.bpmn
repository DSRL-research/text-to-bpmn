  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="doc-5.1" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Main Process">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_86abea5f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Risk assessment Web service">
        <bpmn:flowNodeRef>Activity_4534cbfd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_2c690225</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_99f51fad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_364feb74</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Customer">
        <bpmn:flowNodeRef>Activity_2aec2d54</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_86abea5f" name="Receiving a customer request for a loan amount">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_4534cbfd" name="Assess the request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_2c690225" name="Approved the loan">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_99f51fad" name="Denied the loan">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_364feb74" name="Sent the request">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_2aec2d54" name="Receives feedback">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_86abea5f" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_86abea5f" targetRef="Activity_4534cbfd" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_364feb74" targetRef="Activity_2aec2d54" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_2aec2d54" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_4534cbfd" targetRef="Activity_2c690225" name="If the loan is small and the customer is low risk" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_2c690225" targetRef="Activity_99f51fad" name="If the customer is high risk" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_99f51fad" targetRef="Activity_364feb74" name="If the customer needs further review or the loan amount is for $10,000 or more" />
  </bpmn:process>
