    </bpmn:startEvent>
    <bpmn:task id="Activity_6659bec8" name="Makes the decision to go public">
      <bpmn:documentation>The underwriters</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0fb4eebe" name="Prepare a registration statement for the approval of the Securities and Exchange Commission ( SEC )">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_a30cb18d" name="Check">
      <bpmn:documentation>That the issue complies with the so-called blue-sky laws of each state that regulate sales of securities within the state</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_f6199196" name="Awaiting approval">
