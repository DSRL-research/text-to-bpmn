    </bpmn:task>
    <bpmn:task id="Activity_94d11972" name="Reviewed the report">
      <bpmn:documentation>For automatic approval</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_c6b6dc07" name="Approved">
      <bpmn:documentation>Automatically</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_d0de9daa" name="Require approval">
