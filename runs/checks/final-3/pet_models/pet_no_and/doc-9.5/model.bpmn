    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_a8dd6a41" targetRef="Activity_5905150c" name="If the request is not completed in 7 days" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_5905150c" targetRef="Activity_88267dcd" name="If the request is not finished within 30 days" />
