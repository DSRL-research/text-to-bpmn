<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="text2bpmn" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="loan" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Property appraiser">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_c77ec737</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Loan officer">
        <bpmn:flowNodeRef>Activity_eb19e905</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR_Gateway_228c21f8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_8ad882c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_b4f59f20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_eaa7813f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_c77ec737" name="Approved a loan application">
      <bpmn:documentation>A loan application; The applicant’s loan risk assessment</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_eb19e905" name="Assess the applicant’s eligibility">
      <bpmn:documentation>A credit history check; The loan risk assessment; The property appraisal</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR_Gateway_228c21f8" name="If the applicant is not eligible" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_8ad882c2" name="Rejected the application">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_b4f59f20" name="Prepared the acceptance pack">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_eaa7813f" name="Sent">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_join_1" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_c77ec737" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_eb19e905" targetRef="XOR_Gateway_228c21f8" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="XOR_Gateway_228c21f8" targetRef="Activity_8ad882c2" name="Yes" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="XOR_Gateway_228c21f8" targetRef="Activity_b4f59f20" name="No" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_b4f59f20" targetRef="Activity_eaa7813f" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_8ad882c2" targetRef="Gateway_join_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_eaa7813f" targetRef="Gateway_join_1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_c77ec737" targetRef="Activity_eb19e905" name="If" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_join_1" targetRef="EndEvent_1" />
  </bpmn:process>
