  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="loan" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Property appraiser">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_39a6109c</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Loan officer">
        <bpmn:flowNodeRef>Activity_6cb30bbf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_2b564ceb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_c6ab6b9c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_96f48a73</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_39a6109c" name="Approved a loan application">
      <bpmn:documentation>A loan application; The applicant’s loan risk assessment</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_6cb30bbf" name="Assess the applicant’s eligibility">
      <bpmn:documentation>A credit history check; The loan risk assessment; The property appraisal</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_2b564ceb" name="Rejected the application">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_c6ab6b9c" name="Prepared the acceptance pack">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_96f48a73" name="Sent">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_39a6109c" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_2b564ceb" targetRef="Activity_c6ab6b9c" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_c6ab6b9c" targetRef="Activity_96f48a73" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_96f48a73" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_39a6109c" targetRef="Activity_6cb30bbf" name="If" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_6cb30bbf" targetRef="Activity_2b564ceb" name="If the applicant is not eligible" />
  </bpmn:process>
